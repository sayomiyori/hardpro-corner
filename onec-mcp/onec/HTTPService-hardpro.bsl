////////////////////////////////////////////////////////////////////////////////
// HTTP-сервис "hardpro" для onec-mcp.
//
// Конфигуратор -> Общие -> HTTP-сервисы -> добавить "hardpro":
//   Корневой URL: hardpro
//   Шаблоны URL:  /post, /unpost, /version   (метод POST)
//   Обработчики модуля: post, unpost, version
// Публикация базы: галочка "Публиковать HTTP-сервисы" + права пользователя.
//
// OData не умеет менять Posted, поэтому проведение живёт здесь.
////////////////////////////////////////////////////////////////////////////////

Функция post(Запрос) Экспорт
	Если Не ПроверкаТокена(Запрос) Тогда
		Возврат ОтветJSON(401, Новый Структура("ok, error", Ложь, "bad token"));
	КонецЕсли;
	Попытка
		Данные = ПрочитатьТело(Запрос);
		Результат = ПровестиДокумент(Данные, Истина);
		Возврат ОтветJSON(200, Результат);
	Исключение
		Возврат ОтветJSON(500, Новый Структура("ok, error", Ложь, КраткоеОписаниеОшибки()));
	КонецПопытки;
КонецФункции

Функция unpost(Запрос) Экспорт
	Если Не ПроверкаТокена(Запрос) Тогда
		Возврат ОтветJSON(401, Новый Структура("ok, error", Ложь, "bad token"));
	КонецЕсли;
	Попытка
		Данные = ПрочитатьТело(Запрос);
		Результат = ПровестиДокумент(Данные, Ложь);
		Возврат ОтветJSON(200, Результат);
	Исключение
		Возврат ОтветJSON(500, Новый Структура("ok, error", Ложь, КраткоеОписаниеОшибки()));
	КонецПопытки;
КонецФункции

Функция version(Запрос) Экспорт
	Данные = Новый Структура;
	Данные.Вставить("ok", Истина);
	Данные.Вставить("service", "hardpro");
	Данные.Вставить("user", ИмяПользователя());
	Данные.Вставить("configVersion", Метаданные.Версия);
	Данные.Вставить("time", ТекущаяДатаСеанса());
	Возврат ОтветJSON(200, Данные);
КонецФункции

////////////////////////////////////////////////////////////////////////////////
// Проведение / отмена проведения
////////////////////////////////////////////////////////////////////////////////

Функция ПровестиДокумент(Данные, Провести) Экспорт
	ИмяДокумента = ЗначениеПоля(Данные, "document");
	Идентификатор = ЗначениеПоля(Данные, "ref");

	Если ПустаяСтрока(ИмяДокумента) Или ПустаяСтрока(Идентификатор) Тогда
		ВызватьИсключение "нужны поля document и ref";
	КонецЕсли;

	МетаданныеДокумента = Метаданные.НайтиПоПолномуИмени(ИмяДокумента);
	Если МетаданныеДокумента = Неопределено Или Не МетаданныеДокумента.ЭтоДокумент() Тогда
		ВызватьИсключение "не документ: " + ИмяДокумента;
	КонецЕсли;

	Попытка
		УИД = Новый УникальныйИдентификатор(Идентификатор);
	Исключение
		ВызватьИсключение "ref не guid: " + Идентификатор;
	КонецПопытки;

	Ссылка = Документы[МетаданныеДокумента.Имя].ПолучитьСсылку(УИД);
	Объект = Ссылка.ПолучитьОбъект();
	Если Объект = Неопределено Тогда
		ВызватьИсключение "документ не найден: " + Идентификатор;
	КонецЕсли;

	Если Провести Тогда
		РежимЗаписи = РежимЗаписиДокумента.Проведение;
	Иначе
		РежимЗаписи = РежимЗаписиДокумента.ОтменаПроведения;
	КонецЕсли;
	Объект.Записать(РежимЗаписи);

	ЗаписьЖурналаРегистрации("HARD-PRO.MCP", УровеньЖурналаРегистрации.Информация, , Ссылка,
		?(Провести, "проведение", "отмена проведения") + ", пользователь " + ИмяПользователя());

	Возврат Новый Структура("ok, document, ref, posted",
		Истина, ИмяДокумента, Строка(УИД), Провести);
КонецФункции

////////////////////////////////////////////////////////////////////////////////
// Конфигурация сервиса
////////////////////////////////////////////////////////////////////////////////

Функция ОжидаемыйТокен() Экспорт
	// Пусто — проверка X-Hardpro-Token выключена, доступ решает веб-сервер и 1С.
	// Заполни, если сервис торчит наружу: тогда тот же секрет кладётся в ONEC_SERVICE_TOKEN.
	Возврат "";
КонецФункции

Функция ПроверкаТокена(Запрос) Экспорт
	Ожидаемый = ОжидаемыйТокен();
	Если ПустаяСтрока(Ожидаемый) Тогда
		Возврат Истина;
	КонецЕсли;
	Присланный = Запрос.Заголовки.Получить("X-Hardpro-Token");
	Возврат Присланный = Ожидаемый;
КонецФункции

////////////////////////////////////////////////////////////////////////////////
// JSON и утилиты
////////////////////////////////////////////////////////////////////////////////

Функция ПрочитатьТело(Запрос) Экспорт
	ТелоЗапроса = Запрос.ПолучитьТелоКакСтроку();
	Если ПустаяСтрока(ТелоЗапроса) Тогда
		Возврат Новый Структура;
	КонецЕсли;
	Чтение = Новый ЧтениеJSON;
	Чтение.УстановитьСтроку(ТелоЗапроса);
	Данные = Чтение.Прочитать();
	Чтение.Закрыть();
	Возврат Данные;
КонецФункции

Функция ЗначениеПоля(Данные, Имя) Экспорт
	Если ТипЗнч(Данные) = Тип("Структура") Тогда
		Если Данные.Свойство(Имя) Тогда
			Возврат Данные[Имя];
		КонецЕсли;
	ИначеЕсли ТипЗнч(Данные) = Тип("Соответствие") Тогда
		Значение = Неопределено;
		Если Данные.Получить(Имя, Значение) Тогда
			Возврат Значение;
		КонецЕсли;
	КонецЕсли;
	Возврат "";
КонецФункции

Функция ОтветJSON(КодСостояния, Данные) Экспорт
	Поток = Новый ПотокВПамяти;
	Запись = Новый ЗаписьJSON(Поток, Новый ПараметрыЗаписиJSON(ПереносСтрокJSON.Нет));
	ЗаписатьЗначениеJSON(Запись, Данные);
	Запись.Закрыть();
	Текст = Поток.ПолучитьДвоичныеДанные().ПолучитьСтрокуИзДвоичныхДанных("UTF-8");

	Ответ = Новый HTTPСервисОтвет(КодСостояния);
	Ответ.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
	Ответ.УстановитьТелоИзСтроки(Текст, "UTF-8");
	Возврат Ответ;
КонецФункции

Процедура ЗаписатьЗначениеJSON(Запись, Значение) Экспорт
	Тип = ТипЗнч(Значение);
	Если Значение = Неопределено Тогда
		Запись.ЗаписатьNull();
	ИначеЕсли Тип = Тип("Булево") Или Тип = Тип("Число") Или Тип = Тип("Строка") Тогда
		Запись.ЗаписатьЗначение(Значение);
	ИначеЕсли Тип = Тип("Дата") Тогда
		Запись.ЗаписатьЗначение(Формат(Значение, "ДФ='yyyy-MM-ddTHH:mm:ss'"));
	ИначеЕсли Тип = Тип("Структура") Тогда
		Запись.ЗаписатьНачалоОбъекта();
		Для Каждого Элемент Из Значение Цикл
			Запись.ЗаписатьИмяСвойства(Элемент.Ключ);
			ЗаписатьЗначениеJSON(Запись, Элемент.Значение);
		КонецЦикла;
		Запись.ЗаписатьКонецОбъекта();
	ИначеЕсли Тип = Тип("Соответствие") Тогда
		Запись.ЗаписатьНачалоОбъекта();
		Для Каждого Элемент Из Значение Цикл
			Запись.ЗаписатьИмяСвойства(Элемент.Ключ);
			ЗаписатьЗначениеJSON(Запись, Элемент.Значение);
		КонецЦикла;
		Запись.ЗаписатьКонецОбъекта();
	ИначеЕсли Тип = Тип("Массив") Тогда
		Запись.ЗаписатьНачалоМассива();
		Для Каждого Элемент Из Значение Цикл
			ЗаписатьЗначениеJSON(Запись, Элемент);
		КонецЦикла;
		Запись.ЗаписатьКонецМассива();
	Иначе
		Запись.ЗаписатьЗначение(Строка(Значение));
	КонецЕсли;
КонецПроцедуры
