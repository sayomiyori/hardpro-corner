# ---- подключение к 1С ----
# Стандартный интерфейс OData: <публикация>/odata/standard.odata
ONEC_URL=http://1c.local/erp/odata/standard.odata

# Пользователь 1С с правами на нужные объекты (не администратор, не пустой)
ONEC_USER=hardpro_mcp
ONEC_PASSWORD=

# HTTP-сервис для проведения документов: <публикация>/hs/hardpro
ONEC_SERVICE_URL=http://1c.local/erp/hs/hardpro
ONEC_SERVICE_TOKEN=

# ---- доступ ----
# readonly | write | admin   (write = create/update, admin = + delete)
ONEC_MODE=write

# Белый/чёрный списки имён объектов OData, глобы через запятую
ONEC_ALLOW=Catalog_*,Document_*,InformationRegister_*
ONEC_DENY=Catalog_Пользователи,Catalog_ВнешниеПользователи

# ---- пределы ----
ONEC_TIMEOUT_MS=30000
ONEC_SERVICE_TIMEOUT_MS=120000
ONEC_MAX_ROWS=200
ONEC_BULK_MAX=50
ONEC_MAX_FILTER=4000
ONEC_META_TTL_MS=300000

# ---- аудит ----
ONEC_AUDIT=/var/log/hardpro/onec-mcp.jsonl
