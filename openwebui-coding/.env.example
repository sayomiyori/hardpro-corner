# ---------- context ----------
# Threshold sits BELOW your real window so things never hard-fail.
# 32k window  -> 24000
# 64k window  -> 48000
# 128k window -> 96000
# 200k window -> 140000
ENABLE_CONTEXT_COMPACTION=true
CONTEXT_COMPACTION_TOKEN_THRESHOLD=48000
CONTEXT_COMPACTION_TOKEN_CAP=48000
CONTEXT_COMPACTION_RETENTION_PERCENTAGE=40
# Empty = the chat's own model writes the summary.
# A cheap small model here is faster: qwen2.5:3b, llama3.2:3b, gpt-4.1-nano
CONTEXT_COMPACTION_MODEL=

# ---------- models ----------
# Leave num_ctx UNSET in the UI. This is the instance default.
DEFAULT_NUM_CTX=32768
ENABLE_OLLAMA_API=true
OLLAMA_BASE_URLS=http://host.docker.internal:11434

# ---------- ollama server (profile: local) ----------
OLLAMA_CONTEXT_LENGTH=32768
OLLAMA_KEEP_ALIVE=30m
OLLAMA_FLASH_ATTENTION=1
OLLAMA_KV_CACHE_TYPE=q8_0
OLLAMA_MAX_LOADED_MODELS=1
OLLAMA_NUM_PARALLEL=1

# ---------- features ----------
ENABLE_WEB_SEARCH=false
ENABLE_CODE_INTERPRETER=true
ENABLE_MEMORY=true
ENABLE_SIGNUP=false

# ---------- rag: code drops ----------
RAG_EMBEDDING_ENGINE=ollama
RAG_EMBEDDING_MODEL=nomic-embed-text
RAG_TOP_K=6
CHUNK_SIZE=1200
CHUNK_OVERLAP=200
# Set true when you paste code inline and never want it shredded by RAG.
BYPASS_EMBEDDING_AND_RETRIEVAL=false

# ---------- misc ----------
WEBUI_URL=http://localhost:8080
WEBUI_AUTH=true
AIOHTTP_CLIENT_TIMEOUT=600
