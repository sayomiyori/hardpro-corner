{
  "policy": {
    "evict": true,
    "reserve_mib": 1024,
    "boot_timeout": 420
  },
  "defaults": {
    "subcmd": "serve",
    "n_gpu_layers": 999,
    "n_ctx": 16384,
    "kv_offload": true,
    "args": ["--jinja", "--no-webui", "--offline", "--parallel", "1"]
  },
  "roles": {
    "agent": "hardpro-abliterated-27b",
    "chat": "hardpro-abliterated-27b",
    "media": "hardpro-abliterated-27b",
    "abliterated": "hardpro-abliterated-27b"
  },
  "profiles": {
    "Qwen3.8-Flash-Next": {
      "label": "Qwen3.8 Flash Next",
      "backend": "llamacpp",
      "gpus": [0],
      "port": 8081,
      "model_path": "/srv/models/weights/coding/Qwen3.8-Flash-Next-UD-IQ4_XS/Qwen3.8-Flash-Next-UD-IQ4_XS-00001-of-00004.gguf",
      "n_ctx": 16384,
      "n_gpu_layers": null,
      "vram_mib": 0,
      "autostart": false,
      "args": ["--alias", "Qwen3.8-Flash-Next", "--jinja", "--no-webui", "--offline",
               "--fit", "on", "--flash-attn", "on", "--cache-type-k", "q8_0",
               "--cache-type-v", "q8_0", "--parallel", "1"],
      "note": "89 ГБ шардов: -ngl не задаём, раскладку подбирает --fit, лишнее живёт в RAM"
    },
    "hardpro-media-vision": {
      "label": "HARD-PRO Медиа",
      "backend": "llamacpp",
      "gpus": [1],
      "port": 8083,
      "model_path": "/srv/models/weights/coding/Qwen3.8-27B-UD-Q5_K_M.gguf",
      "mmproj": "/srv/models/weights/hardpro-media/mmproj-qwen3.8-27b-f16.gguf",
      "n_ctx": 16384,
      "n_gpu_layers": 999,
      "vram_mib": 22000,
      "autostart": false,
      "args": ["--alias", "hardpro-media-vision", "--jinja", "--no-webui", "--offline",
               "--mmproj-offload", "--flash-attn", "on", "--cache-type-k", "q8_0",
               "--cache-type-v", "q8_0", "--image-max-tokens", "384",
               "--threads", "16", "--parallel", "1"],
      "note": "27B + mmproj, цельком на карте 1; запасной вариант, когда нужно зрение"
    },
    "hardpro-abliterated-27b": {
      "label": "Abliterated 27B",
      "backend": "llamacpp",
      "gpus": [1],
      "port": 8084,
      "model_path": "/srv/models/weights/coding/Huihui-Qwen3.8-27B-abliterated-Q5_K.gguf",
      "n_ctx": 16384,
      "n_gpu_layers": 999,
      "vram_mib": 22000,
      "autostart": true,
      "args": ["--alias", "Huihui-Qwen3.8-27B-abliterated-Q5_K", "--jinja", "--no-webui",
               "--offline", "--flash-attn", "on", "--cache-type-k", "q8_0",
               "--cache-type-v", "q8_0", "--threads", "16", "--parallel", "1"],
      "note": "27B без цензуры, карта 1 — основная модель всех ролей"
    },
    "qwen3-14b-manager": {
      "label": "Qwen3 14B Manager (vLLM)",
      "backend": "external",
      "base": "http://127.0.0.1:8000",
      "token_env": "VLLM_API_KEY",
      "gpus": [0],
      "vram_mib": 18000,
      "note": "движок менеджера 1С: Qwen3-14B-AWQ, vLLM, GPU 0; живёт в юните hardpro-vllm, каталогом не запускается"
    }
  }
}
