# Публичный репозиторий. Каждый новый путь добавляем после проверки содержимого.
/*
!/.gitignore
!/AGENTS.md
!/README.md

# Для вложенных файлов открыть родительский каталог, закрыть его содержимое
# и разрешить только выбранные файлы. Пример для будущей публичной инструкции:
# !/docs/
# /docs/*
# !/docs/overview.md

# systemd-конфиги сервера hard-pro-llm: юниты, drop-in, установщик
!/systemd/
/systemd/*
!/systemd/README.md
!/systemd/install-autostart.sh
!/systemd/hardpro-vllm.service.d/
!/systemd/hardpro-vllm.service.d/*.conf

# Код проекта: шлюз, доска, агент, traceproxy, MCP 1С, обвязка Open WebUI
!/hardpro-hub/
!/onec-mcp/
!/openwebui-coding/
!/codex2owui.py
!/codex2owui_context.py
!/openwebui_error_explainer.py
!/openwebui-errors-ru.md


# Крупные и приватные выгрузки не публикуем
codex_openwebui.json

