# Пример для Open WebUI на Linux. Подставьте адреса своих локальных сервисов.
# Порядок: менеджер, текстовый роутер, сервис зрения.
OPENAI_API_BASE_URLS=http://127.0.0.1:18080/manager/v1;http://127.0.0.1:18081/v1;http://127.0.0.1:8083/v1
ENABLE_PLUGINS=True
ENABLE_FUNCTIONS=True
ENABLE_TOOLS=False
ENABLE_TOOL_SERVERS=False
AUDIO_STT_ENGINE=
AUDIO_STT_SUPPORTED_CONTENT_TYPES=audio/*
AUDIO_STT_ALLOWED_EXTENSIONS=mp3,wav,m4a,webm,ogg,oga,opus,flac,mp4,mpga,mpeg
WHISPER_MODEL=/srv/models/weights/hardpro-media/whisper-small
WHISPER_VAD_FILTER=True
BYPASS_PYDUB_PREPROCESSING=True
ENABLE_CONTEXT_COMPACTION=True
CONTEXT_COMPACTION_TOKEN_THRESHOLD=220000
CONTEXT_COMPACTION_TOKEN_CAP=220000
CONTEXT_COMPACTION_RETENTION_PERCENTAGE=40
TASK_MODEL_PARAMS='{"max_tokens":1536,"custom_params":{"chat_template_kwargs":{"enable_thinking":false}}}'
